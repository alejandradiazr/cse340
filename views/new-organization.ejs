<%- include('partials/header') %>

    <section class="form-page">

        <h2>New Organization</h2>

        <% if (typeof errors !=='undefined' && errors.length> 0) { %>
            <div class="error-message">
                <ul>
                    <% errors.forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }); %>
                </ul>
            </div>
            <% } %>

                <form action="/new-organization" method="POST">

                    <div class="form-group">
                        <label for="name">Organization Name</label>

                        <input type="text" id="name" name="name" value="<%= typeof name !== 'undefined' ? name : '' %>"
                            required minlength="3" maxlength="150">
                    </div>

                    <div class="form-group">
                        <label for="description">Description</label>

                        <textarea id="description" name="description" required
                            minlength="3"><%= typeof description !== 'undefined' ? description : '' %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="contact_email">Contact Email</label>

                        <input type="email" id="contact_email" name="contact_email"
                            value="<%= typeof contactEmail !== 'undefined' ? contactEmail : '' %>" required
                            minlength="3" maxlength="255">
                    </div>

                    <button type="submit">Create Organization</button>

                    <a href="/organizations">Cancel</a>

                </form>

    </section>

    <%- include('partials/footer') %>