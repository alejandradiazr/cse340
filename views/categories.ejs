<%- include('partials/header') %>

    <section class="categories">

        <h2>Project Categories</h2>

        <p class="intro">
            Browse different types of service opportunities and find a cause that matches your interests.
        </p>

        <div class="cards">

            <% categories.forEach(category=> { %>

                <div class="card">

                    <% if (category.name==='Environmental' ) { %>
                        <h3>🌱 <%= category.name %>
                        </h3>
                        <p>
                            Projects focused on protecting nature, planting trees, and cleaning public spaces.
                        </p>

                        <% } else if (category.name==='Educational' ) { %>
                            <h3>📚 <%= category.name %>
                            </h3>
                            <p>
                                Volunteer opportunities that support learning, tutoring, and mentoring students.
                            </p>

                            <% } else if (category.name==='Community Service' ) { %>
                                <h3>🤝 <%= category.name %>
                                </h3>
                                <p>
                                    Activities that help families and strengthen neighborhoods through volunteer work.
                                </p>

                                <% } else if (category.name==='Health and Wellness' ) { %>
                                    <h3>❤️ <%= category.name %>
                                    </h3>
                                    <p>
                                        Programs that promote healthy lifestyles and provide community health support.
                                    </p>

                                    <% } else if (category.name==='Food Assistance' ) { %>
                                        <h3>🍎 <%= category.name %>
                                        </h3>
                                        <p>
                                            Opportunities that help provide food and support to individuals and families
                                            in need.
                                        </p>
                                        <% } %>

                </div>

                <% }); %>

        </div>

    </section>

    <%- include('partials/footer') %>