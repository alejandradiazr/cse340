<%- include('partials/header') %>

    <section class="category-detail">

        <h2>
            <%= category.name %>
        </h2>

        <p class="intro">
            Service projects in this category.
        </p>

        <div class="cards">

            <% projects.forEach(project=> { %>

                <div class="card">

                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <p>
                        <strong>Location:</strong>
                        <%= project.location %>
                    </p>

                    <p>
                        <strong>Date:</strong>
                        <%= project.date.toLocaleDateString() %>
                    </p>

                    <p>
                        <%= project.description %>
                    </p>

                </div>

            <% }); %>

        </div>

    </section>

    <%- include('partials/footer') %>