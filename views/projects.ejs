<%- include('partials/header') %>

    <section class="projects">

        <h2>Service Projects</h2>

        <p class="intro">
            Discover volunteer opportunities that help strengthen communities and improve lives.
        </p>

        <% if (locals.account_type==='admin' ) { %>
            <a href="/new-project">Create New Project</a>
            <% } %>

                <div class="cards">

                    <% projects.forEach(project=> { %>

                        <% let image='/images/hero-volunteers.jpg' ; if
                            (project.title.toLowerCase().includes('cleanup')) { image='/images/cleanup.webp' ; } else if
                            ( project.title.toLowerCase().includes('garden') ||
                            project.title.toLowerCase().includes('farming') ||
                            project.title.toLowerCase().includes('composting') ||
                            project.title.toLowerCase().includes('planting') ) { image='/images/plantingatree.webp' ; }
                            else if ( project.title.toLowerCase().includes('tutoring') ||
                            project.title.toLowerCase().includes('school') ||
                            project.title.toLowerCase().includes('workshop') ) { image='/images/teaching.webp' ; } else
                            if (project.title.toLowerCase().includes('food')) { image='/images/trash.webp' ; } else if
                            (project.title.toLowerCase().includes('community')) { image='/images/organization.webp' ; }
                            %>

                            <div class="card">

                                <img src="<%= image %>" alt="<%= project.title %>">

                                <h3>
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                </h3>

                                <p>
                                    <strong>Organization:</strong>
                                    <a href="/organization/<%= project.organization_id %>">
                                        <%= project.organization_name %>
                                    </a>
                                </p>

                                <p>
                                    <strong>Location:</strong>
                                    <%= project.location %>
                                </p>

                                <p>
                                    <strong>Date:</strong>
                                    <%= project.date.toLocaleDateString() %>
                                </p>

                                <p>
                                    <%= project.description %>
                                </p>

                                <% if (locals.account_type==='admin' ) { %>
                                    <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
                                    <% } %>

                            </div>

                            <% }); %>

                </div>

    </section>

    <%- include('partials/footer') %>