<%- include('partials/header') %>

    <section class="form-page">

        <h2>Update Categories</h2>

        <h3>
            <%= project.title %>
        </h3>

        <form action="/project/<%= project.project_id %>/categories" method="POST">

            <div class="form-group">

                <% categories.forEach(category=> { %>

                    <div>
                        <label>
                            <input type="checkbox" name="category_ids" value="<%= category.category_id %>"
                                <%=selectedCategoryIds.includes(category.category_id) ? 'checked' : '' %>
                            >

                            <%= category.name %>
                        </label>
                    </div>

                    <% }); %>

            </div>

            <button type="submit">Save Categories</button>

            <a href="/project/<%= project.project_id %>">Cancel</a>

        </form>

    </section>

    <%- include('partials/footer') %>