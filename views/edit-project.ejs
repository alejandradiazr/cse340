<%- include('partials/header') %>

    <section class="form-page">

        <h2>Edit Project</h2>

        <% if (typeof errors !=='undefined' && errors.length> 0) { %>
            <div class="error-message">
                <ul>
                    <% errors.forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }); %>
                </ul>
            </div>
            <% } %>

                <form action="/edit-project/<%= project.project_id %>" method="POST">

                    <div class="form-group">
                        <label for="organization_id">Organization</label>

                        <select id="organization_id" name="organization_id" required>
                            <option value="">Select an organization</option>

                            <% organizations.forEach(organization=> { %>
                                <option value="<%= organization.organization_id %>"
                                    <%=project.organization_id==organization.organization_id ? 'selected' : '' %>
                                    >
                                    <%= organization.name %>
                                </option>
                                <% }); %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="title">Project Title</label>

                        <input type="text" id="title" name="title" value="<%= project.title %>" required>
                    </div>

                    <div class="form-group">
                        <label for="description">Description</label>

                        <textarea id="description" name="description" required><%= project.description %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="location">Location</label>

                        <input type="text" id="location" name="location" value="<%= project.location %>" required>
                    </div>

                    <div class="form-group">
                        <label for="date">Date</label>

                        <input type="date" id="date" name="date" value="<%= typeof project.date === 'string'
    ? project.date
    : project.date.toISOString().split('T')[0] %>" required>
                    </div>

                    <button type="submit">Update Project</button>

                    <a href="/projects">Cancel</a>

                </form>

    </section>

    <%- include('partials/footer') %>