<%- include('partials/header') %>

    <section class="organizations">

        <h2>Organizations</h2>

        <p class="intro">
            Explore organizations that are making a positive impact in communities around the world.
        </p>

        <div class="cards">

            <% organizations.forEach(organization=> { %>

                <div class="card">

                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %>">

                    <h3>
                        <%= organization.name %>
                    </h3>

                    <p>
                        <%= organization.description %>
                    </p>

                    <p>
                        <strong>Contact:</strong>
                        <%= organization.contact_email %>
                    </p>

                </div>

                <% }); %>

        </div>

    </section>

    <%- include('partials/footer') %>